{
  "compilerOptions": {
    // Target and Module
    "target": "ES2020",
    "module": "ESNext",
    // El código ya usa Array.prototype.at, Object.hasOwn y demás de ES2022, que el build admite
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",

    // JSX Support for React
    "jsx": "react-jsx",

    // Allow JavaScript files
    "allowJs": true,
    "checkJs": false,

    // Type Checking
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false,

    // Module Resolution
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Additional Options
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
