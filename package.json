{
  "name": "rydercup-web",
  "private": true,
  "version": "2.56.0",
  "type": "module",
  "description": "Frontend web para Ryder Cup Amateur Manager",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:integration": "playwright test tests/integration.spec.js",
    "test:integration:ci": "playwright test tests/integration.spec.js --project=chromium --workers=1",
    "test:security": "playwright test tests/security.spec.js",
    "lint:architecture": "depcruise src --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@sentry/react": "^11.8.0",
    "framer-motion": "^14.6.0",
    "i18next": "^26.5.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.1.18",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-sri": "^0.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "react",
    "vite",
    "golf",
    "ryder-cup",
    "tournament-management"
  ],
  "author": "Agustín Estévez",
  "license": "UNLICENSED",
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
